/*
 * Boutique Patch Switcher style sheet, skin ju06a-60 (Qt 6.4 QSS).
 * GENERATED FILE when it is named <skin>.qss: docs/design/gen-tokens.py writes
 * assets/theme/<skin>.qss for every skin in docs/design/tokens.json from this template,
 * assets/theme/app.qss.in. Edit the template or the tokens, never the output.
 * Source of every value: docs/design/DESIGN.md (D-05) and docs/design/DESIGN-2.md (skins).
 * Theme loads :/theme/<skin>.qss on every skin switch. Everything drawn with QPainter
 * (displays, section rules, panel buttons, group bar, engine control, bank grid,
 * nameplate and device switcher, list rows, status bar LED) is not styled here; Theme
 * exposes the same resolved tokens as a runtime palette.
 *
 * Template syntax (DESIGN-2.md 2.5): an at sign and a colour token name in braces is replaced
 * by the token's resolved #RRGGBB for the skin; the same with the word skin, by the skin id;
 * a line holding only the same with TOKEN_BLOCK, by the token comment block. Any other
 * such placeholder is a generator error.
 *
 * Skin: ju06a-60 (JU-06A, engine 60)
 * ----------------------------------------------------------------------------------
 * COLOUR TOKENS (DESIGN.md section 2, DESIGN-2.md section 2.3). No other colours appear anywhere.
 * ----------------------------------------------------------------------------------
 * 2.1 Panel and surfaces
 *   panel             #18191A  window background, upper panel, status bar, dialogs
 *   band              #1E1F21  lower band (grid, controls, list)
 *   bandEdge          #46484A  1 px line on top of the band and the status bar
 *   well              #101112  list background
 *   wellEdgeDark      #070808  top and left 1 px border of the list well and fields
 *   wellEdgeLight     #323436  bottom and right 1 px border of the list well
 *   fieldBack         #0B0C0C  search field, combos, spin box, inline editor, tooltip
 *   fieldBorder       #3B3D3F  field border, normal; menu border and separator; disabled checkbox
 *   fieldBorderHover  #4E5052  field border, hover; unchecked checkbox border
 *   rowHover          #1D1E20  list row under the mouse
 *   selection         #303235  highlighted list row, menu item hover
 *   selectionBarIdle  #6E6C66  3 px selection bar when the list is not focused
 *   matchBack         #2B4270  search-match background; text selection in fields
 * 2.2 Display
 *   bezel             #050505  display window
 *   bezelRim          #2C2D2F  1 px frame left, right, bottom of the window
 *   bezelRimTop       #48494B  1 px frame on the top edge of the window
 *   lcdBack           #071104  lit field background
 *   lcdOn             #98CF1C  lit dots
 *   lcdGhost          #0F1D09  unlit dots (switch lcdShowGhost, default true)
 * 2.3 Lettering and rules
 *   labelPrimary      #F0EDE2  legends, list names, values, dialog text
 *   labelSecondary    #ABA79B  secondary labels, addresses, status labels, tags
 *   labelDim          #75726B  placeholder text, unnamed user slots, hints
 *   labelDisabled     #5E5C58  any disabled text
 *   labelAccent       #86A9E6  patch-section titles and numerals, the wordmark
 *   ruleAccent        #2D5BA3  rules of the patch section
 *   ruleSecondary     #8E8A7E  rules of secondary sections, wordmark divider
 *   labelRed          #FF6157  AUTO SEND, NOT FOUND, errors, default-button border
 *   arrow             #BDB9A0  PREV / NEXT wedges, combo arrow
 *   starOff           #5E5D59  unfilled star outline
 *   tagBorder         #4C4B47  box around the key-mode letter
 * 2.4 Buttons and LEDs
 *   buttonSlot        #0B0B0B  1 px recess around every button face
 *   buttonFace        #E3DDCC  face, normal
 *   buttonFaceHover   #EEE9DA  face, hover
 *   buttonPressed     #C2BCAC  face, pressed
 *   buttonHighlight   #F4F0E4  1 px top inside edge of the face (not pressed)
 *   buttonFaceLit     #E3DDCC  face of a button whose LED is lit
 *   buttonDisabled    #3A3936  face, disabled
 *   ledOn             #F2433A  lit LED
 *   ledCore           #FF9C8C  lighter core inside a lit LED
 *   ledOff            #4A2A26  unlit LED
 *   focusRing         #9DBBE8  every keyboard focus indicator (2 px)
 * 2.5 LED readout (64-patch skins)
 *   ledBack           #0A0202  LED readout field
 *   ledSegOn          #FF3A2A  lit segment
 *   ledSegGhost       #1E0705  unlit segment (switch ledShowGhost)
 * 2.6 Panel faces by role
 *   bankFace          #BCA48A  bank face, normal
 *   bankFaceHover     #C9B297  bank face, hover
 *   bankPressed       #9E8971  bank face, pressed
 *   bankHighlight     #D2BFA8  bank face, top highlight
 *   bankFaceLit       #BCA48A  bank face, lit
 *   viewFace          #D8B391  view face, normal
 *   viewFaceHover     #E3BF9F  view face, hover
 *   viewPressed       #B89678  view face, pressed
 *   viewHighlight     #E8CBB0  view face, top highlight
 *   viewFaceLit       #D8B391  view face, lit
 *   commitFace        #E07E3C  commit face, normal
 *   commitFaceHover   #EA8B4A  commit face, hover
 *   commitPressed     #BE6830  commit face, pressed
 *   commitHighlight   #EE9F66  commit face, top highlight
 *   commitFaceLit     #E07E3C  commit face, lit
 *   transportFace     #BCA48A  transport face, normal
 *   transportFaceHover#C9B297  transport face, hover
 *   transportPressed  #9E8971  transport face, pressed
 *   transportHighlight#D2BFA8  transport face, top highlight
 *   transportFaceLit  #BCA48A  transport face, lit
 *   buttonLegend      #1E1E1E  legend on a face (kind B)
 *   wedge             #2A2724  PREV / NEXT wedges
 *   lensRim           #2A2826  ring around a round LED
 *   controlFace       #393B3E  dialog buttons, key caps, scrollbar handle
 *   controlFaceHover  #45474A  dialog buttons and handle, hover
 *   controlPressed    #2B2D2F  dialog buttons and handle, pressed
 * 2.7 Version 2 lettering and section rules
 *   labelNumeral      #F0EDE2  numerals 1 to 8 over the grid
 *   labelCommit       #F29A5A  AUTO SEND label
 *   ruleTitleBack     #202326  title plate of a doubleBar rule
 *   ruleTitleText     #E2E0D4  title text of a doubleBar rule
 *   ruleBand          #2D5BA3  fill of a band rule (patch section)
 *   ruleBandText      #F4F2EA  title text of a band rule
 *   ruleBand2         #B9502E  fill of the engine band rule
 *   ruleBand2Text     #F7F1EA  title text of the engine band
 *
 * ----------------------------------------------------------------------------------
 * TYPE ROLES (DESIGN.md section 3). Family "Inter" (assets/fonts, OFL 1.1) unless the line names another (DESIGN-2.md 3.1), sizes in
 * px. Weight 400 = Regular, 500 = Medium, 600 = SemiBold, 700 = Bold. "Caps" strings are stored in
 * capitals by the code: QSS cannot change case.
 * ----------------------------------------------------------------------------------
 *   role              weight  size  spacing  case        colour
 *   type.panelLabel    500     10    0.5      caps        per use
 *   type.listName      400     14    0        as stored   labelPrimary
 *   type.listAddress   500     13    cells    caps        labelSecondary
 *   type.listMeta      500     10    0.5      caps        labelSecondary
 *   type.field         400     14    0        as typed    labelPrimary
 *   type.statusLabel   500     10    0.5      caps        labelSecondary
 *   type.statusValue   400     11    0        as named    labelPrimary
 *   type.body          400     13    0        sentence    labelPrimary
 *   type.note          400     12    0        sentence    labelSecondary
 *   type.emptyTitle    500     11    1.0      caps        labelSecondary
 *   type.keycap        500     10    0.5      as named    labelPrimary
 *   type.wordmark      700     16    1.0      caps        labelPrimary  Archivo
 *   type.wordmarkSub   500     10    1.0      caps        labelSecondary
 *   type.displayName3  500     28    0        as stored   labelPrimary
 *   type.displayName4  500     37    0        as stored   labelPrimary
 *   type.displayName5  500     46    0        as stored   labelPrimary
 *   type.displayContext3 500     13    1.0      caps        per state
 *   type.displayContext4 500     17    1.5      caps        per state
 *   type.displayContext5 500     21    2.0      caps        per state
 *   type.ruleTitle     500     10    1.0      caps        ruleTitleText / ruleBandText
 *   type.switcherTab   500     10    1.0      caps        per state
 * Application font (Theme): Inter Regular 13 px.
 *
 * ----------------------------------------------------------------------------------
 * NOTES FOR THE BUILDER (Qt 6.4 QSS limits; 1 to 5 checked in a Qt 6.4.2 harness)
 * ----------------------------------------------------------------------------------
 * 1. Letter spacing is not a QSS property. Where a role above has spacing, Theme sets
 *    it in C++ with QFont::setLetterSpacing(QFont::AbsoluteSpacing, n) on the widget's
 *    font; the size and weight set here do not reset it.
 * 2. Object names and the dynamic properties [role="..."] and [state="..."] must be
 *    set before the widget is first shown. Changing one later needs
 *    style()->unpolish(w); style()->polish(w); (QSS does not re-evaluate by itself).
 *    A skin switch is qApp->setStyleSheet(<skin>.qss) once; Qt re-polishes every widget.
 *    The Clear Recents box is a QDialog named clearRecentsBox (DESIGN 10.5); the
 *    QMessageBox selectors below are kept for the old code path and are harmless.
 * 3. #band must be a QFrame (a plain QWidget ignores QSS borders).
 * 4. Combo popups take the item rules below only with
 *    combo->setItemDelegate(new QStyledItemDelegate(combo)).
 * 5. The combo arrow is a raster pair, assets/theme/arrow-down.png (8 x 4) and
 *    arrow-down@2x.png (16 x 8), compiled into the resources under :/theme/. Its colour
 *    is the token `arrow`, which no skin overrides, so one pair serves every skin.
 * 6. :hover rules were not exercised (the offscreen harness has no pointer); check
 *    them by hand in the review screenshots.
 */


/* ---------------------------------------------------------------- backgrounds -- */

QMainWindow,
QDialog,
QMessageBox {
    background-color: #18191A;
    color: #F0EDE2;
}

QFrame#band {
    background-color: #1E1F21;
    border: none;
    border-top: 1px solid #46484A;
}

/* ------------------------------------------------- search field, DESIGN 7.1 -- */

QLineEdit#searchField {
    background-color: #0B0C0C;
    color: #F0EDE2;
    font-size: 14px;
    font-weight: 400;
    border-style: solid;
    border-width: 1px;
    border-top-color: #070808;
    border-left-color: #070808;
    border-bottom-color: #3B3D3F;
    border-right-color: #3B3D3F;
    border-radius: 0px;
    padding: 0px 10px;
    min-height: 30px;
    max-height: 30px;
    selection-background-color: #2B4270;
    selection-color: #F0EDE2;
}

QLineEdit#searchField:hover {
    border: 1px solid #4E5052;
}

QLineEdit#searchField:focus {
    border: 2px solid #9DBBE8;
    padding: 0px 9px;
    min-height: 28px;
    max-height: 28px;
}

/* -------------------------------------------- patch list well, DESIGN 7.2, 7.6 -- */

QListView#patchList {
    background-color: #101112;
    color: #F0EDE2;
    border-style: solid;
    border-width: 1px;
    border-top-color: #070808;
    border-left-color: #070808;
    border-bottom-color: #323436;
    border-right-color: #323436;
    border-radius: 0px;
    outline: 0;
    padding: 0px;
}

QListView#patchList:focus {
    border: 1px solid #9DBBE8;
}

QListView#patchList QScrollBar:vertical {
    background-color: #101112;
    width: 10px;
    margin: 0px;
    border: none;
}

QListView#patchList QScrollBar::handle:vertical {
    background-color: #393B3E;
    min-height: 24px;
    margin: 0px 2px;
    border: none;
    border-radius: 0px;
}

QListView#patchList QScrollBar::handle:vertical:hover {
    background-color: #45474A;
}

QListView#patchList QScrollBar::handle:vertical:pressed {
    background-color: #2B2D2F;
}

QListView#patchList QScrollBar::add-line:vertical,
QListView#patchList QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QListView#patchList QScrollBar::add-page:vertical,
QListView#patchList QScrollBar::sub-page:vertical {
    background: none;
}

/* --------------------------------------------- user-slot editor, DESIGN 7.4 -- */

QLineEdit#nameEditor {
    background-color: #0B0C0C;
    color: #F0EDE2;
    font-size: 14px;
    font-weight: 400;
    border: 1px solid #9DBBE8;
    border-radius: 0px;
    padding: 0px 1px;
    selection-background-color: #2B4270;
    selection-color: #F0EDE2;
}

/* ------------------------------------------------------ status bar, DESIGN 8.1 -- */

QStatusBar#statusBar {
    background-color: #18191A;
    border: none;
    border-top: 1px solid #46484A;
    min-height: 21px;
    max-height: 21px;
}

QStatusBar#statusBar::item {
    border: none;
}

QStatusBar#statusBar QLabel {
    background: transparent;
    padding: 0px;
    margin: 0px;
}

/* OUT, CH, IN */
QStatusBar#statusBar QLabel[role="statusLabel"] {
    color: #ABA79B;
    font-size: 10px;
    font-weight: 500;
}

/* FOLLOW */
QStatusBar#statusBar QLabel[role="statusFollow"] {
    color: #F0EDE2;
    font-size: 10px;
    font-weight: 500;
}

/* NOT FOUND */
QStatusBar#statusBar QLabel[role="statusError"] {
    color: #FF6157;
    font-size: 10px;
    font-weight: 500;
}

/* port names, channel number */
QStatusBar#statusBar QLabel[role="statusValue"] {
    color: #F0EDE2;
    font-size: 11px;
    font-weight: 400;
}

/* "None" when no port is set */
QStatusBar#statusBar QLabel[role="statusDim"] {
    color: #75726B;
    font-size: 11px;
    font-weight: 400;
}

/* right-aligned message */
QStatusBar#statusBar QLabel[role="statusMessage"] {
    color: #ABA79B;
    font-size: 11px;
    font-weight: 400;
}

/* ------------------------------------------------- menus, DESIGN 8.2 -- */

QMenu {
    background-color: #18191A;
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
    border: 1px solid #3B3D3F;
    border-radius: 0px;
    padding: 4px 0px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 12px;
    min-height: 16px;
}

QMenu::item:selected {
    background-color: #303235;
    color: #F0EDE2;
}

QMenu::item:disabled {
    color: #5E5C58;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #3B3D3F;
    margin: 4px 0px;
}

/* ------------------------------------------------ tooltips, DESIGN 8.3 -- */

QToolTip {
    background-color: #0B0C0C;
    color: #F0EDE2;
    font-size: 12px;
    font-weight: 400;
    border: 1px solid #3B3D3F;
    border-radius: 0px;
    padding: 4px 6px;
}

/* ------------------------------------------- dialog text roles, DESIGN 10 -- */

QDialog QLabel,
QMessageBox QLabel {
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

QLabel[role="body"] {
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
}

QLabel[role="note"] {
    color: #ABA79B;
    font-size: 12px;
    font-weight: 400;
}

QLabel[role="dim"] {
    color: #75726B;
    font-size: 12px;
    font-weight: 400;
}

/* Settings form labels: caps, right edge at x 100 (alignment set in code). */
QLabel[role="formLabel"] {
    color: #F0EDE2;
    font-size: 10px;
    font-weight: 500;
}

QLabel#connectionText[state="ok"] {
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
}

QLabel#connectionText[state="error"] {
    color: #FF6157;
    font-size: 13px;
    font-weight: 400;
}

/* Settings input problem line, DESIGN 10.1: right of the input combo. */
QLabel#inputStatusText {
    color: #FF6157;
    font-size: 13px;
    font-weight: 400;
}

/* Shortcuts sheet key caps, DESIGN 10.3: 18 px tall overall, min 18 px wide. */
QLabel#keycap {
    color: #F0EDE2;
    background-color: #393B3E;
    font-size: 10px;
    font-weight: 500;
    border: 1px solid #0B0B0B;
    border-bottom: 2px solid #0B0B0B;
    border-radius: 2px;
    padding: 1px 6px;
    min-height: 13px;
    max-height: 13px;
    min-width: 4px;
    qproperty-alignment: AlignCenter;
}

/* ----------------------------------------- dialog buttons, DESIGN 10.2 -- */
/* 28 px tall overall, min 100 px wide overall. Text is caps, set by the code. */

QDialog QPushButton,
QMessageBox QPushButton {
    background-color: #393B3E;
    color: #F0EDE2;
    font-size: 10px;
    font-weight: 500;
    border: 1px solid #0B0B0B;
    border-radius: 2px;
    padding: 0px 12px;
    min-width: 74px;
    min-height: 26px;
    max-height: 26px;
}

QDialog QPushButton:hover,
QMessageBox QPushButton:hover {
    background-color: #45474A;
}

QDialog QPushButton:pressed,
QMessageBox QPushButton:pressed {
    background-color: #2B2D2F;
}

QDialog QPushButton:default,
QMessageBox QPushButton:default {
    border: 1px solid #FF6157;
}

QDialog QPushButton:focus,
QMessageBox QPushButton:focus {
    border: 2px solid #9DBBE8;
    padding: 0px 11px;
    min-width: 74px;
    min-height: 24px;
    max-height: 24px;
}

QDialog QPushButton:disabled,
QMessageBox QPushButton:disabled {
    background-color: #3A3936;
    color: #5E5C58;
    border: 1px solid #0B0B0B;
}

/* REFRESH in Settings is 26 px overall to match the combo beside it (DESIGN 10.1).
   The ID selector outranks the shared :focus rule, so its focus state is repeated. */
QDialog QPushButton#refreshButton {
    min-height: 24px;
    max-height: 24px;
}

QDialog QPushButton#refreshButton:focus {
    min-height: 22px;
    max-height: 22px;
}

/* USE next to the port combos in Settings (DESIGN-2.md 7.3): 26 px overall like REFRESH,
   72 px wide overall. */
QDialog QPushButton#useOutputButton,
QDialog QPushButton#useInputButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 24px;
    max-height: 24px;
}

QDialog QPushButton#useOutputButton:focus,
QDialog QPushButton#useInputButton:focus {
    min-width: 46px;
    max-width: 46px;
    min-height: 22px;
    max-height: 22px;
}

QMessageBox QPushButton#clearButton,
QDialog#clearRecentsBox QPushButton#clearButton {
    color: #FF6157;
}

/* ------------------------------------------------- combo box, DESIGN 10.2 -- */
/* 26 px tall overall. */

QComboBox {
    combobox-popup: 0;
    background-color: #0B0C0C;
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
    border: 1px solid #3B3D3F;
    border-radius: 0px;
    padding: 0px 0px 0px 8px;
    min-height: 24px;
    max-height: 24px;
    selection-background-color: #303235;
    selection-color: #F0EDE2;
}

QComboBox:hover {
    border: 1px solid #4E5052;
}

QComboBox:focus {
    border: 2px solid #9DBBE8;
    padding: 0px 0px 0px 7px;
    min-height: 22px;
    max-height: 22px;
}

QComboBox:disabled {
    color: #5E5C58;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

/* 8 x 4 solid wedge in `arrow` (see note 5); Qt picks the @2x file at DPR 2. */
QComboBox::down-arrow {
    image: url(:/theme/arrow-down.png);
    width: 8px;
    height: 4px;
}

QComboBox QAbstractItemView {
    background-color: #18191A;
    color: #F0EDE2;
    border: 1px solid #3B3D3F;
    padding: 4px 0px;
    outline: 0;
    selection-background-color: #303235;
    selection-color: #F0EDE2;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 0px 12px;
    border: none;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #303235;
    color: #F0EDE2;
}

/* -------------------------------------------------- spin box, DESIGN 10.2 -- */
/* 72 x 26 overall; arrows hidden (keys and wheel change the value). */

QSpinBox {
    background-color: #0B0C0C;
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
    border: 1px solid #3B3D3F;
    border-radius: 0px;
    padding: 0px;
    min-width: 70px;
    max-width: 70px;
    min-height: 24px;
    max-height: 24px;
    selection-background-color: #2B4270;
    selection-color: #F0EDE2;
    qproperty-buttonSymbols: NoButtons;
    qproperty-alignment: AlignCenter;
}

QSpinBox:hover {
    border: 1px solid #4E5052;
}

QSpinBox:focus {
    border: 2px solid #9DBBE8;
    min-width: 68px;
    max-width: 68px;
    min-height: 22px;
    max-height: 22px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 0px;
    border: none;
}

/* -------------------------------------------- checkbox (an LED), DESIGN 10.2 -- */
/* Indicator 16 x 6 overall (14 x 4 plus a 1 px border). */

QCheckBox {
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 400;
    spacing: 10px;
    background: transparent;
}

QCheckBox:disabled {
    color: #5E5C58;
}

QCheckBox::indicator {
    width: 14px;
    height: 4px;
    background-color: #4A2A26;
    border: 1px solid #4E5052;
    border-radius: 0px;
}

QCheckBox::indicator:checked {
    background-color: #F2433A;
    border: 1px solid #F2433A;
}

QCheckBox::indicator:focus {
    border: 1px solid #9DBBE8;
}

QCheckBox::indicator:disabled {
    background-color: #3A3936;
    border: 1px solid #3B3D3F;
}

/* ------------------------------------------- Settings, version 2 (DESIGN-2.md 7) -- */

/* Engine information on the JU-06A page: read-only values. */
QLabel[role="engineValue"] {
    color: #F0EDE2;
    font-size: 13px;
    font-weight: 500;
}

/* "unknown" and other absent values. */
QLabel[role="engineUnknown"] {
    color: #75726B;
    font-size: 13px;
    font-weight: 400;
}

/* The refusal under the channel row ("Channel 4 on Hapax MIDI 1 is used by the D-05"). */
QLabel#channelConflictText {
    color: #FF6157;
    font-size: 12px;
    font-weight: 400;
}
