/*
 * Boutique Patch Switcher style sheet, skin jp08 (Qt 6.4 QSS).
 * GENERATED FILE when it is named <skin>.qss: docs/design/gen-tokens.py writes
 * assets/theme/<skin>.qss for every skin in docs/design/tokens.json from this template,
 * assets/theme/app.qss.in. Edit the template or the tokens, never the output.
 * Source of every value: docs/design/DESIGN.md (D-05) and docs/design/DESIGN-2.md (skins).
 * Theme loads :/theme/<skin>.qss on every skin switch. Everything drawn with QPainter
 * (displays, section rules, panel buttons, group bar, engine control, bank grid,
 * nameplate and device switcher, list rows, status bar LED) is not styled here; Theme
 * exposes the same resolved tokens as a runtime palette.
 *
 * Template syntax (DESIGN-2.md 2.5): an at sign and a colour token name in braces is replaced
 * by the token's resolved #RRGGBB for the skin; the same with the word skin, by the skin id;
 * a line holding only the same with TOKEN_BLOCK, by the token comment block. Any other
 * such placeholder is a generator error.
 *
 * Skin: jp08 (JP-08)
 * ----------------------------------------------------------------------------------
 * COLOUR TOKENS (DESIGN.md section 2, DESIGN-2.md section 2.3). No other colours appear anywhere.
 * ----------------------------------------------------------------------------------
 * 2.1 Panel and surfaces
 *   panel             #121314  window background, upper panel, status bar, dialogs
 *   band              #17181A  lower band (grid, controls, list)
 *   bandEdge          #3E4044  1 px line on top of the band and the status bar
 *   well              #0B0C0D  list background
 *   wellEdgeDark      #050506  top and left 1 px border of the list well and fields
 *   wellEdgeLight     #2C2E31  bottom and right 1 px border of the list well
 *   fieldBack         #08090A  search field, combos, spin box, inline editor, tooltip
 *   fieldBorder       #36383C  field border, normal; menu border and separator; disabled checkbox
 *   fieldBorderHover  #4A4D52  field border, hover; unchecked checkbox border
 *   rowHover          #1A1B1D  list row under the mouse
 *   selection         #2C2E33  highlighted list row, menu item hover
 *   selectionBarIdle  #6E7177  3 px selection bar when the list is not focused
 *   matchBack         #5A2616  search-match background; text selection in fields
 * 2.2 Display
 *   bezel             #050505  display window
 *   bezelRim          #2A2C2F  1 px frame left, right, bottom of the window
 *   bezelRimTop       #4A4D52  1 px frame on the top edge of the window
 *   lcdBack           #071104  lit field background
 *   lcdOn             #98CF1C  lit dots
 *   lcdGhost          #0F1D09  unlit dots (switch lcdShowGhost, default true)
 * 2.3 Lettering and rules
 *   labelPrimary      #ECEDEE  legends, list names, values, dialog text
 *   labelSecondary    #A9ADB3  secondary labels, addresses, status labels, tags
 *   labelDim          #6C7076  placeholder text, unnamed user slots, hints
 *   labelDisabled     #55585D  any disabled text
 *   labelAccent       #F07A4A  patch-section titles and numerals, the wordmark
 *   ruleAccent        #C8441F  rules of the patch section
 *   ruleSecondary     #80848A  rules of secondary sections, wordmark divider
 *   labelRed          #FF5E4D  AUTO SEND, NOT FOUND, errors, default-button border
 *   arrow             #BDB9A0  PREV / NEXT wedges, combo arrow
 *   starOff           #55585D  unfilled star outline
 *   tagBorder         #45484C  box around the key-mode letter
 * 2.4 Buttons and LEDs
 *   buttonSlot        #050505  1 px recess around every button face
 *   buttonFace        #CFCBC2  face, normal
 *   buttonFaceHover   #DCD8CF  face, hover
 *   buttonPressed     #ABA8A0  face, pressed
 *   buttonHighlight   #E6E3DC  1 px top inside edge of the face (not pressed)
 *   buttonFaceLit     #CFCBC2  face of a button whose LED is lit
 *   buttonDisabled    #3A3B3E  face, disabled
 *   ledOn             #FF3B30  lit LED
 *   ledCore           #FF9C8C  lighter core inside a lit LED
 *   ledOff            #4A2420  unlit LED
 *   focusRing         #9DBBE8  every keyboard focus indicator (2 px)
 * 2.5 LED readout (64-patch skins)
 *   ledBack           #0A0402  LED readout field
 *   ledSegOn          #FF6B1A  lit segment
 *   ledSegGhost       #1F0D05  unlit segment (switch ledShowGhost)
 * 2.6 Panel faces by role
 *   bankFace          #CFCBC2  bank face, normal
 *   bankFaceHover     #DCD8CF  bank face, hover
 *   bankPressed       #ABA8A0  bank face, pressed
 *   bankHighlight     #E6E3DC  bank face, top highlight
 *   bankFaceLit       #CFCBC2  bank face, lit
 *   viewFace          #2F74B5  view face, normal
 *   viewFaceHover     #3A80C0  view face, hover
 *   viewPressed       #275F96  view face, pressed
 *   viewHighlight     #4D8DCA  view face, top highlight
 *   viewFaceLit       #2F74B5  view face, lit
 *   commitFace        #C2341F  commit face, normal
 *   commitFaceHover   #CE422C  commit face, hover
 *   commitPressed     #A02A18  commit face, pressed
 *   commitHighlight   #D65A46  commit face, top highlight
 *   commitFaceLit     #C2341F  commit face, lit
 *   transportFace     #C9982C  transport face, normal
 *   transportFaceHover#D5A53B  transport face, hover
 *   transportPressed  #A67D22  transport face, pressed
 *   transportHighlight#DDB45A  transport face, top highlight
 *   transportFaceLit  #C9982C  transport face, lit
 *   buttonLegend      #18191B  legend on a face (kind B)
 *   wedge             #1A1A1A  PREV / NEXT wedges
 *   lensRim           #141414  ring around a round LED
 *   controlFace       #34363A  dialog buttons, key caps, scrollbar handle
 *   controlFaceHover  #404247  dialog buttons and handle, hover
 *   controlPressed    #26282B  dialog buttons and handle, pressed
 * 2.7 Version 2 lettering and section rules
 *   labelNumeral      #ECEDEE  numerals 1 to 8 over the grid
 *   labelCommit       #FF6B4A  AUTO SEND label
 *   ruleTitleBack     #2B2D33  title plate of a doubleBar rule
 *   ruleTitleText     #F2F3F4  title text of a doubleBar rule
 *   ruleBand          #6E8EBA  fill of a band rule (patch section)
 *   ruleBandText      #E2E0D4  title text of a band rule
 *   ruleBand2         #6E8EBA  fill of the engine band rule
 *   ruleBand2Text     #E2E0D4  title text of the engine band
 *
 * ----------------------------------------------------------------------------------
 * TYPE ROLES (DESIGN.md section 3). Family "Inter" (assets/fonts, OFL 1.1) unless the line names another (DESIGN-2.md 3.1), sizes in
 * px. Weight 400 = Regular, 500 = Medium. "Caps" strings are stored in capitals by the
 * code: QSS cannot change case.
 * ----------------------------------------------------------------------------------
 *   role              weight  size  spacing  case        colour
 *   type.panelLabel    500     10    0.5      caps        per use
 *   type.listName      400     14    0        as stored   labelPrimary
 *   type.listAddress   500     13    cells    caps        labelSecondary
 *   type.listMeta      500     10    0.5      caps        labelSecondary
 *   type.field         400     14    0        as typed    labelPrimary
 *   type.statusLabel   500     10    0.5      caps        labelSecondary
 *   type.statusValue   400     11    0        as named    labelPrimary
 *   type.body          400     13    0        sentence    labelPrimary
 *   type.note          400     12    0        sentence    labelSecondary
 *   type.emptyTitle    500     11    1.0      caps        labelSecondary
 *   type.keycap        500     10    0.5      as named    labelPrimary
 *   type.wordmark      600     16    2.0      caps        labelAccent  Archivo
 *   type.wordmarkSub   500     10    1.0      caps        labelSecondary
 *   type.displayName3  500     28    0        as stored   labelPrimary
 *   type.displayName4  500     37    0        as stored   labelPrimary
 *   type.displayName5  500     46    0        as stored   labelPrimary
 *   type.displayContext3500     13    1.0      caps        per state
 *   type.displayContext4500     17    1.5      caps        per state
 *   type.displayContext5500     21    2.0      caps        per state
 *   type.ruleTitle     500     10    1.0      caps        ruleTitleText / ruleBandText
 *   type.switcherTab   500     10    1.0      caps        per state
 * Application font (Theme): Inter Regular 13 px.
 *
 * ----------------------------------------------------------------------------------
 * NOTES FOR THE BUILDER (Qt 6.4 QSS limits; 1 to 5 checked in a Qt 6.4.2 harness)
 * ----------------------------------------------------------------------------------
 * 1. Letter spacing is not a QSS property. Where a role above has spacing, Theme sets
 *    it in C++ with QFont::setLetterSpacing(QFont::AbsoluteSpacing, n) on the widget's
 *    font; the size and weight set here do not reset it.
 * 2. Object names and the dynamic properties [role="..."] and [state="..."] must be
 *    set before the widget is first shown. Changing one later needs
 *    style()->unpolish(w); style()->polish(w); (QSS does not re-evaluate by itself).
 *    A skin switch is qApp->setStyleSheet(<skin>.qss) once; Qt re-polishes every widget.
 *    The Clear Recents box is a QDialog named clearRecentsBox (DESIGN 10.5); the
 *    QMessageBox selectors below are kept for the old code path and are harmless.
 * 3. #band must be a QFrame (a plain QWidget ignores QSS borders).
 * 4. Combo popups take the item rules below only with
 *    combo->setItemDelegate(new QStyledItemDelegate(combo)).
 * 5. The combo arrow is a raster pair, assets/theme/arrow-down.png (8 x 4) and
 *    arrow-down@2x.png (16 x 8), compiled into the resources under :/theme/. Its colour
 *    is the token `arrow`, which no skin overrides, so one pair serves every skin.
 * 6. :hover rules were not exercised (the offscreen harness has no pointer); check
 *    them by hand in the review screenshots.
 */


/* ---------------------------------------------------------------- backgrounds -- */

QMainWindow,
QDialog,
QMessageBox {
    background-color: #121314;
    color: #ECEDEE;
}

QFrame#band {
    background-color: #17181A;
    border: none;
    border-top: 1px solid #3E4044;
}

/* ------------------------------------------------- search field, DESIGN 7.1 -- */

QLineEdit#searchField {
    background-color: #08090A;
    color: #ECEDEE;
    font-size: 14px;
    font-weight: 400;
    border-style: solid;
    border-width: 1px;
    border-top-color: #050506;
    border-left-color: #050506;
    border-bottom-color: #36383C;
    border-right-color: #36383C;
    border-radius: 0px;
    padding: 0px 10px;
    min-height: 30px;
    max-height: 30px;
    selection-background-color: #5A2616;
    selection-color: #ECEDEE;
}

QLineEdit#searchField:hover {
    border: 1px solid #4A4D52;
}

QLineEdit#searchField:focus {
    border: 2px solid #9DBBE8;
    padding: 0px 9px;
    min-height: 28px;
    max-height: 28px;
}

/* -------------------------------------------- patch list well, DESIGN 7.2, 7.6 -- */

QListView#patchList {
    background-color: #0B0C0D;
    color: #ECEDEE;
    border-style: solid;
    border-width: 1px;
    border-top-color: #050506;
    border-left-color: #050506;
    border-bottom-color: #2C2E31;
    border-right-color: #2C2E31;
    border-radius: 0px;
    outline: 0;
    padding: 0px;
}

QListView#patchList:focus {
    border: 1px solid #9DBBE8;
}

QListView#patchList QScrollBar:vertical {
    background-color: #0B0C0D;
    width: 10px;
    margin: 0px;
    border: none;
}

QListView#patchList QScrollBar::handle:vertical {
    background-color: #34363A;
    min-height: 24px;
    margin: 0px 2px;
    border: none;
    border-radius: 0px;
}

QListView#patchList QScrollBar::handle:vertical:hover {
    background-color: #404247;
}

QListView#patchList QScrollBar::handle:vertical:pressed {
    background-color: #26282B;
}

QListView#patchList QScrollBar::add-line:vertical,
QListView#patchList QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QListView#patchList QScrollBar::add-page:vertical,
QListView#patchList QScrollBar::sub-page:vertical {
    background: none;
}

/* --------------------------------------------- user-slot editor, DESIGN 7.4 -- */

QLineEdit#nameEditor {
    background-color: #08090A;
    color: #ECEDEE;
    font-size: 14px;
    font-weight: 400;
    border: 1px solid #9DBBE8;
    border-radius: 0px;
    padding: 0px 1px;
    selection-background-color: #5A2616;
    selection-color: #ECEDEE;
}

/* ------------------------------------------------------ status bar, DESIGN 8.1 -- */

QStatusBar#statusBar {
    background-color: #121314;
    border: none;
    border-top: 1px solid #3E4044;
    min-height: 21px;
    max-height: 21px;
}

QStatusBar#statusBar::item {
    border: none;
}

QStatusBar#statusBar QLabel {
    background: transparent;
    padding: 0px;
    margin: 0px;
}

/* OUT, CH, IN */
QStatusBar#statusBar QLabel[role="statusLabel"] {
    color: #A9ADB3;
    font-size: 10px;
    font-weight: 500;
}

/* FOLLOW */
QStatusBar#statusBar QLabel[role="statusFollow"] {
    color: #ECEDEE;
    font-size: 10px;
    font-weight: 500;
}

/* NOT FOUND */
QStatusBar#statusBar QLabel[role="statusError"] {
    color: #FF5E4D;
    font-size: 10px;
    font-weight: 500;
}

/* port names, channel number */
QStatusBar#statusBar QLabel[role="statusValue"] {
    color: #ECEDEE;
    font-size: 11px;
    font-weight: 400;
}

/* "None" when no port is set */
QStatusBar#statusBar QLabel[role="statusDim"] {
    color: #6C7076;
    font-size: 11px;
    font-weight: 400;
}

/* right-aligned message */
QStatusBar#statusBar QLabel[role="statusMessage"] {
    color: #A9ADB3;
    font-size: 11px;
    font-weight: 400;
}

/* ------------------------------------------------- menus, DESIGN 8.2 -- */

QMenu {
    background-color: #121314;
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
    border: 1px solid #36383C;
    border-radius: 0px;
    padding: 4px 0px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 12px;
    min-height: 16px;
}

QMenu::item:selected {
    background-color: #2C2E33;
    color: #ECEDEE;
}

QMenu::item:disabled {
    color: #55585D;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #36383C;
    margin: 4px 0px;
}

/* ------------------------------------------------ tooltips, DESIGN 8.3 -- */

QToolTip {
    background-color: #08090A;
    color: #ECEDEE;
    font-size: 12px;
    font-weight: 400;
    border: 1px solid #36383C;
    border-radius: 0px;
    padding: 4px 6px;
}

/* ------------------------------------------- dialog text roles, DESIGN 10 -- */

QDialog QLabel,
QMessageBox QLabel {
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

QLabel[role="body"] {
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
}

QLabel[role="note"] {
    color: #A9ADB3;
    font-size: 12px;
    font-weight: 400;
}

QLabel[role="dim"] {
    color: #6C7076;
    font-size: 12px;
    font-weight: 400;
}

/* Settings form labels: caps, right edge at x 100 (alignment set in code). */
QLabel[role="formLabel"] {
    color: #ECEDEE;
    font-size: 10px;
    font-weight: 500;
}

QLabel#connectionText[state="ok"] {
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
}

QLabel#connectionText[state="error"] {
    color: #FF5E4D;
    font-size: 13px;
    font-weight: 400;
}

/* Settings input problem line, DESIGN 10.1: right of the input combo. */
QLabel#inputStatusText {
    color: #FF5E4D;
    font-size: 13px;
    font-weight: 400;
}

/* Shortcuts sheet key caps, DESIGN 10.3: 18 px tall overall, min 18 px wide. */
QLabel#keycap {
    color: #ECEDEE;
    background-color: #34363A;
    font-size: 10px;
    font-weight: 500;
    border: 1px solid #050505;
    border-bottom: 2px solid #050505;
    border-radius: 2px;
    padding: 1px 6px;
    min-height: 13px;
    max-height: 13px;
    min-width: 4px;
    qproperty-alignment: AlignCenter;
}

/* ----------------------------------------- dialog buttons, DESIGN 10.2 -- */
/* 28 px tall overall, min 100 px wide overall. Text is caps, set by the code. */

QDialog QPushButton,
QMessageBox QPushButton {
    background-color: #34363A;
    color: #ECEDEE;
    font-size: 10px;
    font-weight: 500;
    border: 1px solid #050505;
    border-radius: 2px;
    padding: 0px 12px;
    min-width: 74px;
    min-height: 26px;
    max-height: 26px;
}

QDialog QPushButton:hover,
QMessageBox QPushButton:hover {
    background-color: #404247;
}

QDialog QPushButton:pressed,
QMessageBox QPushButton:pressed {
    background-color: #26282B;
}

QDialog QPushButton:default,
QMessageBox QPushButton:default {
    border: 1px solid #FF5E4D;
}

QDialog QPushButton:focus,
QMessageBox QPushButton:focus {
    border: 2px solid #9DBBE8;
    padding: 0px 11px;
    min-width: 74px;
    min-height: 24px;
    max-height: 24px;
}

QDialog QPushButton:disabled,
QMessageBox QPushButton:disabled {
    background-color: #3A3B3E;
    color: #55585D;
    border: 1px solid #050505;
}

/* REFRESH in Settings is 26 px overall to match the combo beside it (DESIGN 10.1).
   The ID selector outranks the shared :focus rule, so its focus state is repeated. */
QDialog QPushButton#refreshButton {
    min-height: 24px;
    max-height: 24px;
}

QDialog QPushButton#refreshButton:focus {
    min-height: 22px;
    max-height: 22px;
}

/* USE next to the port combos in Settings (DESIGN-2.md 7.3): 26 px overall like REFRESH,
   72 px wide overall. */
QDialog QPushButton#useOutputButton,
QDialog QPushButton#useInputButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 24px;
    max-height: 24px;
}

QDialog QPushButton#useOutputButton:focus,
QDialog QPushButton#useInputButton:focus {
    min-width: 46px;
    max-width: 46px;
    min-height: 22px;
    max-height: 22px;
}

QMessageBox QPushButton#clearButton,
QDialog#clearRecentsBox QPushButton#clearButton {
    color: #FF5E4D;
}

/* ------------------------------------------------- combo box, DESIGN 10.2 -- */
/* 26 px tall overall. */

QComboBox {
    combobox-popup: 0;
    background-color: #08090A;
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
    border: 1px solid #36383C;
    border-radius: 0px;
    padding: 0px 0px 0px 8px;
    min-height: 24px;
    max-height: 24px;
    selection-background-color: #2C2E33;
    selection-color: #ECEDEE;
}

QComboBox:hover {
    border: 1px solid #4A4D52;
}

QComboBox:focus {
    border: 2px solid #9DBBE8;
    padding: 0px 0px 0px 7px;
    min-height: 22px;
    max-height: 22px;
}

QComboBox:disabled {
    color: #55585D;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

/* 8 x 4 solid wedge in `arrow` (see note 5); Qt picks the @2x file at DPR 2. */
QComboBox::down-arrow {
    image: url(:/theme/arrow-down.png);
    width: 8px;
    height: 4px;
}

QComboBox QAbstractItemView {
    background-color: #121314;
    color: #ECEDEE;
    border: 1px solid #36383C;
    padding: 4px 0px;
    outline: 0;
    selection-background-color: #2C2E33;
    selection-color: #ECEDEE;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 0px 12px;
    border: none;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #2C2E33;
    color: #ECEDEE;
}

/* -------------------------------------------------- spin box, DESIGN 10.2 -- */
/* 72 x 26 overall; arrows hidden (keys and wheel change the value). */

QSpinBox {
    background-color: #08090A;
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
    border: 1px solid #36383C;
    border-radius: 0px;
    padding: 0px;
    min-width: 70px;
    max-width: 70px;
    min-height: 24px;
    max-height: 24px;
    selection-background-color: #5A2616;
    selection-color: #ECEDEE;
    qproperty-buttonSymbols: NoButtons;
    qproperty-alignment: AlignCenter;
}

QSpinBox:hover {
    border: 1px solid #4A4D52;
}

QSpinBox:focus {
    border: 2px solid #9DBBE8;
    min-width: 68px;
    max-width: 68px;
    min-height: 22px;
    max-height: 22px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 0px;
    border: none;
}

/* -------------------------------------------- checkbox (an LED), DESIGN 10.2 -- */
/* Indicator 16 x 6 overall (14 x 4 plus a 1 px border). */

QCheckBox {
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 400;
    spacing: 10px;
    background: transparent;
}

QCheckBox:disabled {
    color: #55585D;
}

QCheckBox::indicator {
    width: 14px;
    height: 4px;
    background-color: #4A2420;
    border: 1px solid #4A4D52;
    border-radius: 0px;
}

QCheckBox::indicator:checked {
    background-color: #FF3B30;
    border: 1px solid #FF3B30;
}

QCheckBox::indicator:focus {
    border: 1px solid #9DBBE8;
}

QCheckBox::indicator:disabled {
    background-color: #3A3B3E;
    border: 1px solid #36383C;
}

/* ------------------------------------------- Settings, version 2 (DESIGN-2.md 7) -- */

/* Engine information on the JU-06A page: read-only values. */
QLabel[role="engineValue"] {
    color: #ECEDEE;
    font-size: 13px;
    font-weight: 500;
}

/* "unknown" and other absent values. */
QLabel[role="engineUnknown"] {
    color: #6C7076;
    font-size: 13px;
    font-weight: 400;
}

/* The refusal under the channel row ("Channel 4 on Hapax MIDI 1 is used by the D-05"). */
QLabel#channelConflictText {
    color: #FF5E4D;
    font-size: 12px;
    font-weight: 400;
}
